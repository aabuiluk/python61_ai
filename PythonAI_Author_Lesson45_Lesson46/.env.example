OPENAI_API_KEY=YOUR_KEY_HERE
# Оберіть одну модель, дозволену в проєкті (Settings → Limits → Allowed models):
#   gpt-4.1-mini            — за замовчуванням, усі завдання
#   gpt-4o-mini             — усі завдання (або gpt-4o-mini-2024-07-18)
#   gpt-4o-2024-08-06       — усі завдання, дорожча
#   gpt-5-mini              — reasoning-модель, повільніша (або gpt-5-mini-2025-08-07)
#   gpt-5-2025-08-07        — reasoning-модель, найдорожча
#   gpt-3.5-turbo-16k       — лише текстові завдання, без tools і JSON-схем
OPENAI_MODEL=gpt-4.1-mini
