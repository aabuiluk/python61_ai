OPENAI_API_KEY=YOUR_KEY_HERE
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Empty URL = persistent Qdrant Local, no Docker required.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=store_47_48
RAG_SCORE_THRESHOLD=0.25
# Optional separate tracing service; used only by examples/langsmith_optional.py --send
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=store-47-48
